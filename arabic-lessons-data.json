[{"num":1,"title":"Алфавит","blocks":[{"type":"p","text":"В арабском языке 28 букв, и все они обозначают согласные звуки (долгие «а», «и», «у» передаются буквами ا, ي, و). Пишут и читают справа налево. У каждой буквы есть до четырёх начертаний — в зависимости от того, стоит она отдельно, в начале, середине или конце слова. Шесть букв (ا د ذ ر ز و) не соединяются со следующей буквой, поэтому после них всегда начинается как бы «новый кусок» слова."},{"type":"alphabet","letters":[{"name":"Алиф","letter":"ا","isolated":"ا","initial":"ا","medial":"ـا","final":"ـا","sound":"долгое «а» (сам не соединяется со следующей буквой)","example":{"ar":"أَب","translit":"ab","ru":"отец"}},{"name":"Ба","letter":"ب","isolated":"ب","initial":"بـ","medial":"ـبـ","final":"ـب","sound":"«б»","example":{"ar":"بَيْت","translit":"bayt","ru":"дом"}},{"name":"Та","letter":"ت","isolated":"ت","initial":"تـ","medial":"ـتـ","final":"ـت","sound":"«т»","example":{"ar":"تُفَّاح","translit":"tuffah","ru":"яблоко"}},{"name":"Са","letter":"ث","isolated":"ث","initial":"ثـ","medial":"ـثـ","final":"ـث","sound":"межзубное «с» (как англ. th в think)","example":{"ar":"ثَلاثَة","translit":"thalatha","ru":"три"}},{"name":"Джим","letter":"ج","isolated":"ج","initial":"جـ","medial":"ـجـ","final":"ـج","sound":"«дж»","example":{"ar":"جَبَل","translit":"jabal","ru":"гора"}},{"name":"Ха","letter":"ح","isolated":"ح","initial":"حـ","medial":"ـحـ","final":"ـح","sound":"глубокое гортанное «х»","example":{"ar":"حُبّ","translit":"hubb","ru":"любовь"}},{"name":"Кха","letter":"خ","isolated":"خ","initial":"خـ","medial":"ـخـ","final":"ـخ","sound":"горловое «х» с хрипотцой (как в рус. «хлеб», но резче)","example":{"ar":"خُبْز","translit":"khubz","ru":"хлеб"}},{"name":"Даль","letter":"د","isolated":"د","initial":"د","medial":"ـد","final":"ـد","sound":"«д» (не соединяется со следующей буквой)","example":{"ar":"دَرْس","translit":"dars","ru":"урок"}},{"name":"Заль","letter":"ذ","isolated":"ذ","initial":"ذ","medial":"ـذ","final":"ـذ","sound":"межзубное «з» (как англ. th в this)","example":{"ar":"ذَهَب","translit":"dhahab","ru":"золото"}},{"name":"Ра","letter":"ر","isolated":"ر","initial":"ر","medial":"ـر","final":"ـر","sound":"раскатистое «р» (не соединяется со следующей буквой)","example":{"ar":"رَجُل","translit":"rajul","ru":"мужчина"}},{"name":"Зай","letter":"ز","isolated":"ز","initial":"ز","medial":"ـز","final":"ـز","sound":"«з» (не соединяется со следующей буквой)","example":{"ar":"زَيْتُون","translit":"zaytun","ru":"оливки"}},{"name":"Син","letter":"س","isolated":"س","initial":"سـ","medial":"ـسـ","final":"ـس","sound":"«с»","example":{"ar":"سَمَاء","translit":"sama'","ru":"небо"}},{"name":"Шин","letter":"ش","isolated":"ش","initial":"شـ","medial":"ـشـ","final":"ـش","sound":"«ш»","example":{"ar":"شَمْس","translit":"shams","ru":"солнце"}},{"name":"Сад","letter":"ص","isolated":"ص","initial":"صـ","medial":"ـصـ","final":"ـص","sound":"эмфатическое (твёрдое) «с»","example":{"ar":"صَلاة","translit":"salah","ru":"молитва"}},{"name":"Дад","letter":"ض","isolated":"ض","initial":"ضـ","medial":"ـضـ","final":"ـض","sound":"эмфатическое (твёрдое) «д»","example":{"ar":"ضَوْء","translit":"daw'","ru":"свет"}},{"name":"Та (эмф.)","letter":"ط","isolated":"ط","initial":"طـ","medial":"ـطـ","final":"ـط","sound":"эмфатическое (твёрдое) «т»","example":{"ar":"طَعَام","translit":"ta'am","ru":"еда"}},{"name":"За (эмф.)","letter":"ظ","isolated":"ظ","initial":"ظـ","medial":"ـظـ","final":"ـظ","sound":"эмфатическое (твёрдое) межзубное «з»","example":{"ar":"ظُهْر","translit":"zuhr","ru":"полдень"}},{"name":"Айн","letter":"ع","isolated":"ع","initial":"عـ","medial":"ـعـ","final":"ـع","sound":"гортанный звук, произносимый сжатием горла (нет аналога в русском)","example":{"ar":"عِلْم","translit":"ilm","ru":"знание"}},{"name":"Гайн","letter":"غ","isolated":"غ","initial":"غـ","medial":"ـغـ","final":"ـغ","sound":"грассирующее горловое «г» (как франц. r)","example":{"ar":"غَنِيّ","translit":"ghaniyy","ru":"богатый"}},{"name":"Фа","letter":"ف","isolated":"ف","initial":"فـ","medial":"ـفـ","final":"ـف","sound":"«ф»","example":{"ar":"فِيل","translit":"fil","ru":"слон"}},{"name":"Каф (глуб.)","letter":"ق","isolated":"ق","initial":"قـ","medial":"ـقـ","final":"ـق","sound":"глубокое, гортанное «к» (образуется в самой глубине горла)","example":{"ar":"قَلَم","translit":"qalam","ru":"ручка/карандаш"}},{"name":"Каф","letter":"ك","isolated":"ك","initial":"كـ","medial":"ـكـ","final":"ـك","sound":"«к»","example":{"ar":"كِتَاب","translit":"kitab","ru":"книга"}},{"name":"Лям","letter":"ل","isolated":"ل","initial":"لـ","medial":"ـلـ","final":"ـل","sound":"«л»","example":{"ar":"لَيْل","translit":"layl","ru":"ночь"}},{"name":"Мим","letter":"م","isolated":"م","initial":"مـ","medial":"ـمـ","final":"ـم","sound":"«м»","example":{"ar":"مَاء","translit":"ma'","ru":"вода"}},{"name":"Нун","letter":"ن","isolated":"ن","initial":"نـ","medial":"ـنـ","final":"ـن","sound":"«н»","example":{"ar":"نُور","translit":"nur","ru":"свет (сияние)"}},{"name":"Ха (лёгк.)","letter":"ه","isolated":"ه","initial":"هـ","medial":"ـهـ","final":"ـه","sound":"лёгкое «х», как выдох","example":{"ar":"هِلَال","translit":"hilal","ru":"полумесяц"}},{"name":"Вав","letter":"و","isolated":"و","initial":"و","medial":"ـو","final":"ـو","sound":"«в», а также долгое «у» (не соединяется со следующей буквой)","example":{"ar":"وَرَقَة","translit":"waraqa","ru":"лист (бумаги)"}},{"name":"Йа","letter":"ي","isolated":"ي","initial":"يـ","medial":"ـيـ","final":"ـي","sound":"«й», а также долгое «и»","example":{"ar":"يَد","translit":"yad","ru":"рука"}}]}]},{"num":2,"title":"Огласовки (харакят)","blocks":[{"type":"p","text":"Сами буквы передают только согласные звуки. Краткие гласные показывают маленькие значки над и под буквой — харакят. В обычных текстах (газеты, книги без Корана) их обычно не пишут — читающий уже знает слово; но в учебных текстах и в Коране они проставляются всегда."},{"type":"vocab","items":[{"ar":"بَ","translit":"ba","ru":"Фатха ( َ ) — короткая «а», пишется чёрточкой над буквой"},{"ar":"بِ","translit":"bi","ru":"Кясра ( ِ ) — короткая «и», пишется чёрточкой под буквой"},{"ar":"بُ","translit":"bu","ru":"Дамма ( ُ ) — короткая «у», пишется завитком над буквой"},{"ar":"بْ","translit":"b","ru":"Сукун ( ْ ) — означает отсутствие гласного после согласной"},{"ar":"بَّ","translit":"bba","ru":"Шадда ( ّ ) — удваивает согласную (ставится вместе с любой из огласовок)"},{"ar":"باً","translit":"ban","ru":"Фатхатан ( ً ) — «ан», танвин (двойная фатха) в конце неопределённого имени"},{"ar":"بٍ","translit":"bin","ru":"Кясратан ( ٍ ) — «ин», танвин (двойная кясра) в конце неопределённого имени"},{"ar":"بٌ","translit":"bun","ru":"Дамматан ( ٌ ) — «ун», танвин (двойная дамма) в конце неопределённого имени"}]}]},{"num":3,"title":"Приветствия и вежливые фразы","blocks":[{"type":"p","text":"Первые фразы, с которых стоит начать — это то, что мусульмане говорят друг другу каждый день."},{"type":"vocab","items":[{"ar":"السَّلَامُ عَلَيْكُمْ","translit":"as-salamu alaykum","ru":"мир вам (приветствие)"},{"ar":"وَعَلَيْكُمُ السَّلَام","translit":"wa alaykumu s-salam","ru":"и вам мир (ответ на приветствие)"},{"ar":"صَبَاحُ الْخَيْر","translit":"sabahu l-khayr","ru":"доброе утро"},{"ar":"مَسَاءُ الْخَيْر","translit":"masa'u l-khayr","ru":"добрый вечер"},{"ar":"كَيْفَ حَالُكَ؟","translit":"kayfa haluka?","ru":"как твои дела? (мужчине)"},{"ar":"كَيْفَ حَالُكِ؟","translit":"kayfa haluki?","ru":"как твои дела? (женщине)"},{"ar":"بِخَيْر، الْحَمْدُ لِلَّه","translit":"bikhayr, al-hamdu lillah","ru":"хорошо, хвала Аллаху"},{"ar":"شُكْرًا","translit":"shukran","ru":"спасибо"},{"ar":"عَفْوًا","translit":"afwan","ru":"пожалуйста / не за что"},{"ar":"مِنْ فَضْلِكَ","translit":"min fadlika","ru":"пожалуйста (просьба, мужчине)"},{"ar":"نَعَمْ","translit":"na'am","ru":"да"},{"ar":"لَا","translit":"la","ru":"нет"},{"ar":"مَعَ السَّلَامَة","translit":"ma'a s-salama","ru":"до свидания"}]},{"type":"p","text":"Слова этой фразы перемешаны — собери её заново, нажимая на слова снизу по порядку."},{"type":"sentence","items":[{"words":["السَّلَامُ","عَلَيْكُمْ"],"ru":"мир вам (приветствие)"},{"words":["وَعَلَيْكُمُ","السَّلَام"],"ru":"и вам мир (ответ на приветствие)"},{"words":["صَبَاحُ","الْخَيْر"],"ru":"доброе утро"},{"words":["مَسَاءُ","الْخَيْر"],"ru":"добрый вечер"},{"words":["مِنْ","فَضْلِكَ"],"ru":"пожалуйста (просьба, мужчине)"},{"words":["مَعَ","السَّلَامَة"],"ru":"до свидания"}]}]},{"num":4,"title":"Личные местоимения","blocks":[{"type":"p","text":"Арабские местоимения различают не только число, но и род — «ты» и «вы» звучат по-разному для мужчин и женщин."},{"type":"vocab","items":[{"ar":"أَنَا","translit":"ana","ru":"я"},{"ar":"أَنْتَ","translit":"anta","ru":"ты (мужчине)"},{"ar":"أَنْتِ","translit":"anti","ru":"ты (женщине)"},{"ar":"هُوَ","translit":"huwa","ru":"он"},{"ar":"هِيَ","translit":"hiya","ru":"она"},{"ar":"نَحْنُ","translit":"nahnu","ru":"мы"},{"ar":"أَنْتُمْ","translit":"antum","ru":"вы (группе мужчин или смешанной группе)"},{"ar":"أَنْتُنَّ","translit":"antunna","ru":"вы (группе женщин)"},{"ar":"هُمْ","translit":"hum","ru":"они (мужчины / смешанная группа)"},{"ar":"هُنَّ","translit":"hunna","ru":"они (женщины)"}]},{"type":"p","text":"Есть ещё и двойственное число (для «двоих») — оно понадобится позже, а для начала этих форм достаточно."}]},{"num":5,"title":"Указательные местоимения: этот и тот","blocks":[{"type":"p","text":"«Этот/эта» и «тот/та» тоже меняются по роду."},{"type":"vocab","items":[{"ar":"هَذَا","translit":"hatha","ru":"этот, это (о предмете мужского рода)"},{"ar":"هَذِهِ","translit":"hathihi","ru":"эта, это (о предмете женского рода)"},{"ar":"ذَلِكَ","translit":"thalika","ru":"тот (мужской род)"},{"ar":"تِلْكَ","translit":"tilka","ru":"та (женский род)"}]},{"type":"vocab","title":"Примеры","items":[{"ar":"هَذَا كِتَابٌ","translit":"hatha kitabun","ru":"это книга"},{"ar":"هَذِهِ سَيَّارَةٌ","translit":"hathihi sayyaratun","ru":"это машина"},{"ar":"ذَلِكَ بَيْتٌ كَبِيرٌ","translit":"thalika baytun kabirun","ru":"тот дом большой"}]},{"type":"p","text":"Слова этой фразы перемешаны — собери её заново, нажимая на слова снизу по порядку."},{"type":"sentence","items":[{"words":["هَذَا","كِتَابٌ"],"ru":"это книга"},{"words":["هَذِهِ","سَيَّارَةٌ"],"ru":"это машина"},{"words":["ذَلِكَ","بَيْتٌ","كَبِيرٌ"],"ru":"тот дом большой"}]}]},{"num":6,"title":"Именное предложение","blocks":[{"type":"p","text":"В настоящем времени арабскому языку не нужен глагол «быть» — «дом [есть] большой» строится напрямую: подлежащее + сказуемое. Определённый артикль الـ («аль-») приклеивается к слову и означает «тот самый», «известный», как английское the."},{"type":"vocab","items":[{"ar":"اَلْبَيْتُ كَبِيرٌ","translit":"al-baytu kabirun","ru":"дом (этот, известный) — большой"},{"ar":"اَلْكِتَابُ جَدِيدٌ","translit":"al-kitabu jadidun","ru":"книга — новая"},{"ar":"مُحَمَّدٌ طَالِبٌ","translit":"muhammadun talibun","ru":"Мухаммад — студент"},{"ar":"اَلطَّعَامُ لَذِيذٌ","translit":"at-ta'amu ladhidhun","ru":"еда — вкусная"}]},{"type":"p","text":"Заметь: без артикля («студент», «дом» вообще, какой-то) в конце слова часто стоит танвин — ٌ («-ун»), с артиклем танвин пропадает."},{"type":"p","text":"Слова этой фразы перемешаны — собери её заново, нажимая на слова снизу по порядку."},{"type":"sentence","items":[{"words":["اَلْبَيْتُ","كَبِيرٌ"],"ru":"дом (этот, известный) — большой"},{"words":["اَلْكِتَابُ","جَدِيدٌ"],"ru":"книга — новая"},{"words":["مُحَمَّدٌ","طَالِبٌ"],"ru":"Мухаммад — студент"},{"words":["اَلطَّعَامُ","لَذِيذٌ"],"ru":"еда — вкусная"}]}]},{"num":7,"title":"Род имён","blocks":[{"type":"p","text":"У большинства слов женского рода на конце стоит особая буква — та marбута (ة), которая читается как «а» (или «ат» перед другим словом в изафете, см. позже). Мужской род — обычно без неё."},{"type":"vocab","items":[{"ar":"مُعَلِّمٌ / مُعَلِّمَةٌ","translit":"mu'allimun / mu'allimatun","ru":"учитель / учительница"},{"ar":"طَالِبٌ / طَالِبَةٌ","translit":"talibun / talibatun","ru":"студент / студентка"},{"ar":"كَبِيرٌ / كَبِيرَةٌ","translit":"kabirun / kabiratun","ru":"большой / большая"},{"ar":"جَدِيدٌ / جَدِيدَةٌ","translit":"jadidun / jadidatun","ru":"новый / новая"}]},{"type":"p","text":"Есть и слова женского рода без ة (например «солнце» شَمْس — она женского рода), но это скорее исключения, которые запоминаются со словом."}]},{"num":8,"title":"Числительные 1–10","blocks":[{"type":"vocab","items":[{"ar":"وَاحِد","translit":"wahid","ru":"один"},{"ar":"اِثْنَان","translit":"ithnan","ru":"два"},{"ar":"ثَلَاثَة","translit":"thalatha","ru":"три"},{"ar":"أَرْبَعَة","translit":"arba'a","ru":"четыре"},{"ar":"خَمْسَة","translit":"khamsa","ru":"пять"},{"ar":"سِتَّة","translit":"sitta","ru":"шесть"},{"ar":"سَبْعَة","translit":"sab'a","ru":"семь"},{"ar":"ثَمَانِيَة","translit":"thamaniya","ru":"восемь"},{"ar":"تِسْعَة","translit":"tis'a","ru":"девять"},{"ar":"عَشَرَة","translit":"ashara","ru":"десять"}]},{"type":"p","text":"Числительные в арабском — отдельная большая тема (с 3 по 10 они согласуются с существительным «наоборот» по роду), это только первое знакомство со счётом."}]},{"num":9,"title":"Вопросительные слова","blocks":[{"type":"vocab","items":[{"ar":"مَنْ؟","translit":"man?","ru":"кто?"},{"ar":"مَا؟ / مَاذَا؟","translit":"ma? / matha?","ru":"что?"},{"ar":"أَيْنَ؟","translit":"ayna?","ru":"где?"},{"ar":"مَتَى؟","translit":"mata?","ru":"когда?"},{"ar":"لِمَاذَا؟","translit":"limatha?","ru":"почему?"},{"ar":"كَيْفَ؟","translit":"kayfa?","ru":"как?"},{"ar":"كَمْ؟","translit":"kam?","ru":"сколько?"},{"ar":"أَيّ؟","translit":"ayy?","ru":"какой? который?"}]},{"type":"vocab","title":"Примеры","items":[{"ar":"مَنْ أَنْتَ؟","translit":"man anta?","ru":"кто ты?"},{"ar":"أَيْنَ الْبَيْتُ؟","translit":"ayna l-baytu?","ru":"где дом?"},{"ar":"كَمِ السَّاعَةُ؟","translit":"kami s-sa'atu?","ru":"который час?"}]},{"type":"p","text":"Слова этой фразы перемешаны — собери её заново, нажимая на слова снизу по порядку."},{"type":"sentence","items":[{"words":["مَنْ","أَنْتَ؟"],"ru":"кто ты?"},{"words":["أَيْنَ","الْبَيْتُ؟"],"ru":"где дом?"},{"words":["كَمِ","السَّاعَةُ؟"],"ru":"который час?"}]}]},{"num":10,"title":"Семья","blocks":[{"type":"vocab","items":[{"ar":"أَب","translit":"ab","ru":"отец"},{"ar":"أُمّ","translit":"umm","ru":"мать"},{"ar":"اِبْن","translit":"ibn","ru":"сын"},{"ar":"اِبْنَة / بِنْت","translit":"ibna / bint","ru":"дочь"},{"ar":"أَخ","translit":"akh","ru":"брат"},{"ar":"أُخْت","translit":"ukht","ru":"сестра"},{"ar":"جَدّ","translit":"jadd","ru":"дедушка"},{"ar":"جَدَّة","translit":"jadda","ru":"бабушка"},{"ar":"زَوْج","translit":"zawj","ru":"муж"},{"ar":"زَوْجَة","translit":"zawja","ru":"жена"}]}]},{"num":11,"title":"Цвета","blocks":[{"type":"vocab","items":[{"ar":"أَحْمَر","translit":"ahmar","ru":"красный"},{"ar":"أَزْرَق","translit":"azraq","ru":"синий"},{"ar":"أَخْضَر","translit":"akhdar","ru":"зелёный"},{"ar":"أَصْفَر","translit":"asfar","ru":"жёлтый"},{"ar":"أَبْيَض","translit":"abyad","ru":"белый"},{"ar":"أَسْوَد","translit":"aswad","ru":"чёрный"},{"ar":"بُنِّيّ","translit":"bunniyy","ru":"коричневый"}]},{"type":"p","text":"Эти цвета — особая грамматическая модель (على وزن أفعل): в женском роде они звучат иначе, например أحمر → حمراء (hamra' — красная). Это тоже тема для будущих уроков."}]},{"num":12,"title":"Предлоги места","blocks":[{"type":"vocab","items":[{"ar":"فِي","translit":"fi","ru":"в"},{"ar":"عَلَى","translit":"ala","ru":"на"},{"ar":"مِنْ","translit":"min","ru":"из, от"},{"ar":"إِلَى","translit":"ila","ru":"к, в (направление)"},{"ar":"تَحْتَ","translit":"tahta","ru":"под"},{"ar":"فَوْقَ","translit":"fawqa","ru":"над"},{"ar":"أَمَامَ","translit":"amama","ru":"перед"},{"ar":"خَلْفَ","translit":"khalfa","ru":"за, позади"},{"ar":"بَيْنَ","translit":"bayna","ru":"между"},{"ar":"مَعَ","translit":"ma'a","ru":"с (вместе)"}]},{"type":"vocab","title":"Пример","items":[{"ar":"اَلْكِتَابُ عَلَى الطَّاوِلَةِ","translit":"al-kitabu ala t-tawilati","ru":"книга на столе"}]},{"type":"p","text":"Слова этой фразы перемешаны — собери её заново, нажимая на слова снизу по порядку."},{"type":"sentence","items":[{"words":["اَلْكِتَابُ","عَلَى","الطَّاوِلَةِ"],"ru":"книга на столе"}]}]},{"num":13,"title":"Идафа — притяжательная конструкция","blocks":[{"type":"p","text":"Чтобы сказать «книга студента» или «дом Аллаха», в арабском не нужен отдельный предлог «принадлежности» — два существительных просто ставятся друг за другом (эта конструкция называется идафа, изафет). Первое слово (мудаф) теряет артикль الـ и танвин, второе (мудаф илейхи) стоит с артиклем الـ в родительном падеже."},{"type":"vocab","items":[{"ar":"كِتَابُ الطَّالِبِ","translit":"kitabu t-talibi","ru":"книга студента"},{"ar":"بَيْتُ اللهِ","translit":"baytu llahi","ru":"дом Аллаха (Кааба)"},{"ar":"بَابُ الْبَيْتِ","translit":"babu l-bayti","ru":"дверь дома"},{"ar":"رَسُولُ اللهِ","translit":"rasulu llahi","ru":"Посланник Аллаха"}]},{"type":"p","text":"Такую же конструкцию используют и с местоимениями-суффиксами: كِتَابِي (kitabi) — «моя книга», بَيْتُكَ (baytuka) — «твой дом» и так далее."},{"type":"p","text":"Слова этой фразы перемешаны — собери её заново, нажимая на слова снизу по порядку."},{"type":"sentence","items":[{"words":["كِتَابُ","الطَّالِبِ"],"ru":"книга студента"},{"words":["بَيْتُ","اللهِ"],"ru":"дом Аллаха (Кааба)"},{"words":["بَابُ","الْبَيْتِ"],"ru":"дверь дома"},{"words":["رَسُولُ","اللهِ"],"ru":"Посланник Аллаха"}]}]},{"num":14,"title":"Глагол в прошедшем времени","blocks":[{"type":"p","text":"Арабский глагол в прошедшем времени спрягается через окончания, добавляемые к корню. Возьмём для примера глагол كَتَبَ (kataba) — «писать, написал»."},{"type":"vocab","items":[{"ar":"كَتَبَ","translit":"kataba","ru":"он написал"},{"ar":"كَتَبَتْ","translit":"katabat","ru":"она написала"},{"ar":"كَتَبْتُ","translit":"katabtu","ru":"я написал(а)"},{"ar":"كَتَبْتَ","translit":"katabta","ru":"ты написал (мужчине)"},{"ar":"كَتَبْتِ","translit":"katabti","ru":"ты написала (женщине)"},{"ar":"كَتَبْنَا","translit":"katabna","ru":"мы написали"},{"ar":"كَتَبُوا","translit":"kataboo","ru":"они написали (мужчины)"},{"ar":"كَتَبْنَ","translit":"katabna","ru":"они написали (женщины)"}]},{"type":"p","text":"По этой же схеме спрягается почти любой трёхбуквенный глагол в прошедшем времени, например: قَرَأَ (qara'a) — «читал», ذَهَبَ (dhahaba) — «пошёл», دَخَلَ (dakhala) — «вошёл»."}]},{"num":15,"title":"Полезные фразы для намаза и жизни","blocks":[{"type":"p","text":"Эти выражения мусульмане используют каждый день — многие уже знакомы по остальным разделам приложения."},{"type":"vocab","items":[{"ar":"بِسْمِ اللهِ","translit":"bismillah","ru":"с именем Аллаха"},{"ar":"اَلْحَمْدُ لِلَّه","translit":"al-hamdu lillah","ru":"хвала Аллаху"},{"ar":"إِنْ شَاءَ اللهُ","translit":"insha'Allah","ru":"если пожелает Аллах"},{"ar":"مَا شَاءَ اللهُ","translit":"masha'Allah","ru":"как пожелал Аллах (восхищение)"},{"ar":"سُبْحَانَ اللهِ","translit":"subhanAllah","ru":"пречист Аллах"},{"ar":"اَللهُ أَكْبَر","translit":"Allahu akbar","ru":"Аллах превелик"},{"ar":"أَسْتَغْفِرُ اللهَ","translit":"astaghfirullah","ru":"прошу прощения у Аллаха"},{"ar":"جَزَاكَ اللهُ خَيْرًا","translit":"jazaka Allahu khayran","ru":"да воздаст тебе Аллах благом (мужчине)"},{"ar":"بَارَكَ اللهُ فِيكَ","translit":"barakaAllahu fika","ru":"да благословит тебя Аллах"},{"ar":"اَللَّهُمَّ صَلِّ عَلَى مُحَمَّد","translit":"Allahumma salli ala Muhammad","ru":"о Аллах, благослови Мухаммада"}]},{"type":"p","text":"Слова этой фразы перемешаны — собери её заново, нажимая на слова снизу по порядку."},{"type":"sentence","items":[{"words":["بِسْمِ","اللهِ"],"ru":"с именем Аллаха"},{"words":["اَلْحَمْدُ","لِلَّه"],"ru":"хвала Аллаху"},{"words":["سُبْحَانَ","اللهِ"],"ru":"пречист Аллах"},{"words":["اَللهُ","أَكْبَر"],"ru":"Аллах превелик"},{"words":["أَسْتَغْفِرُ","اللهَ"],"ru":"прошу прощения у Аллаха"},{"words":["بَارَكَ","اللهُ","فِيكَ"],"ru":"да благословит тебя Аллах"},{"words":["اَللَّهُمَّ","صَلِّ","عَلَى","مُحَمَّد"],"ru":"о Аллах, благослови Мухаммада"}]}]}]